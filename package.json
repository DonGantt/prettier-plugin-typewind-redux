{
  "name": "prettier-plugin-typewind-redux",
  "version": "0.1.0",
  "description": "Prettier plugin for typewind (v3) and typewind-v4 — sorts tw. property chains into canonical Tailwind order",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "pretest": "node scripts/setup-test-fixture.js",
    "test": "jest",
    "release": "release-it"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "keywords": [
    "prettier",
    "prettier-plugin",
    "typewind",
    "tailwindcss"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/estree": "^1.0.6",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.0",
    "release-it": "^17.8.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typewind-v4": "^0.1.3"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0",
    "tailwindcss": ">=3.0.0",
    "typewind": "*",
    "typewind-v4": "*"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "typewind": {
      "optional": true
    },
    "typewind-v4": {
      "optional": true
    }
  },
  "overrides": {
    "@octokit/core": "5.2.1"
  }
}
